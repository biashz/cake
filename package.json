{
  "name": "cake",
  "version": "0.0.0",
  "description": "Cake — a TypeScript CLI programming agent",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "cake": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "cake": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/openai": "^4.0.108",
    "ai": "^7.0.162",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
