{
  "name": "cake",
  "version": "0.1.0",
  "description": "Cake — a TypeScript CLI programming agent",
  "keywords": [
    "cli",
    "agent",
    "coding-agent",
    "ai",
    "mcp"
  ],
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "license": "UNLICENSED",
  "bin": {
    "cake": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/sea"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "dev": "tsup --watch",
    "cake": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "desktop:build": "tsup && vite build --config web/vite.config.ts",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:smoke": "npm run desktop:build && electron dist/desktop/smoke.cjs",
    "desktop:e2e": "npm run desktop:build && playwright test --config e2e/playwright.config.ts",
    "desktop:start": "npm run desktop:build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "cli:binary": "node scripts/build-cli-binary.mjs",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis portable",
    "desktop:dist:dir": "npm run desktop:build && electron-builder --win dir"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/openai": "^4.0.108",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "ai": "^7.0.162",
    "execa": "^10.2.1",
    "fast-glob": "^3.3.3",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
